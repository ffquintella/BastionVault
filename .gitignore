# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Remove Cargo.lock from gitignore if creating an executable, leave it for libraries
# More information here https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html
Cargo.lock

# These are backup files generated by rustfmt
**/*.rs.bk
*~
*.bak

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb


# Added by cargo

/target

# Isolated target dir for the `bv-plugin-pack` packer/signer, kept out
# of the shared ./target so plugin builds don't invalidate the GUI's
# cache (see PLUGINS_PACK_TARGET_DIR in the Makefile).
/target-plugin-pack

# VIM temp file
*.swp

# npm dependencies and tool caches (the vitest run cache under
# node_modules/.vite was tracked by accident and rewritten on every
# `npx vitest run`; gui/.gitignore only covers gui/node_modules).
node_modules/

# Claude Code local settings (machine-local)
.claude/
.DS_Store

# Local container-image push config (operator-specific; written by
# `make container-repo-setup`, consumed by `make container-image-push`).
.container-repo.env

# ── Cargo registry credentials — NEVER commit these ────────────────
#
# The Cloudsmith API key for the `uox-bastionvault` registry is a
# publish credential: leaking it lets anyone push a crate that this
# workspace (and the container build) will then resolve and compile.
#
# The supported places for the token are BOTH outside the repo:
#   * `$CARGO_HOME/credentials.toml` — written by
#     `cargo login --registry uox-bastionvault` (see `make crates-login`)
#   * `$CARGO_REGISTRIES_UOX_BASTIONVAULT_TOKEN` — for CI
#
# Cargo does not read a project-local `.cargo/credentials{,.toml}`, so
# these two entries are belt-and-braces against a token pasted into the
# repo by hand or by a copy of Cloudsmith's own instructions (which are
# written for `~/.cargo/credentials`).
.cargo/credentials
.cargo/credentials.toml

# Cargo DOES read the project-local `.cargo/config.toml`, and that file
# is tracked — so a token pasted there gets committed. Cargo has no
# `config.local.toml` override, so there is no in-repo escape hatch:
# per-machine registry settings go in `$CARGO_HOME/config.toml` or in
# `CARGO_*` env vars. The header comment in `.cargo/config.toml` says so
# at the point of temptation.

# `cargo package` / `cargo publish` staging output.
/target/package

# The release plan `make crates-publish-changed` computes once and hands to
# the publish run, so the set you confirm is exactly the set that ships. It is
# deleted on the way out; this catches the run that was interrupted between
# the two.
/.crates-plan.json

# Staging directory for the standalone desktop release artefacts
# (`make release-local` / `make release-linux-appimage` / -macos-pkg /
# -windows-msi, and the `standalone-release` workflow's publish job).
# Installers, not sources — never committed.
/dist/
