{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend-api",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-l", "-c", "cargo run -- server --config config/dev.hcl"],
      "port": 8200
    },
    {
      "name": "gui-frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "gui"],
      "port": 1420
    },
    {
      "name": "docs",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-i", "-c", "cd docs && npx docusaurus start"],
      "port": 3000
    },
    {
      "name": "downloads-site",
      "runtimeExecutable": "/bin/zsh",
      "runtimeArgs": ["-l", "-c", "cargo run -p bv-downloads-server -- --root ./cmd/bv-downloads-server/fixtures/v0.4.0 --addr 127.0.0.1:8090 --verify-hashes"],
      "port": 8090
    }
  ]
}
