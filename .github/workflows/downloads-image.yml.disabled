# BastionVault client-downloads container image — build + push.
#
# Wave 3 / Phase 2 of the Packaging & Distribution roadmap:
# - linux/amd64 only
# - pushed to GHCR on a v*.*.* tag
# - tags: vX.Y.Z, vX.Y, vX, latest
#
# EXPLICITLY NOT SIGNED. There is no `cosign sign` step, no SBOM and no
# attestation here, and that is the Phase 2 scope, not an oversight —
# multi-arch, Cosign keyless signing and the CycloneDX SBOM land together in
# Phase 3. The sibling server workflow (container-image.yml) already has all
# three; copy them from there rather than re-deriving them. Until then the
# operator docs must not advertise a verification path this workflow does not
# produce — deploy/downloads/README.md § Status says so.
#
# DISABLED, like every other image workflow in this repository: the file name
# carries a `.disabled` suffix so GitHub Actions does not dispatch it, and the
# definition stays in version control. Re-enable by stripping the suffix. See
# commit 8ba5d8c ("ci: disable all GitHub Actions workflows"); the integration
# CI that actually runs today lives in the internal `esi/bv-build` repository.
#
# See:
#   roadmaps/packaging-and-distribution.md
#   features/packaging-distribution-website.md
#   deploy/downloads/Containerfile
#   deploy/downloads/README.md

name: downloads-image

on:
  push:
    tags:
      - 'v*.*.*'
  workflow_dispatch:
    inputs:
      tag:
        description: 'Optional override tag to push as (e.g. v0.4.0-rc1). Leave blank to use the git tag (push events) or "manual-<sha>" (workflow_dispatch).'
        required: false
        default: ''

permissions:
  contents: read
  packages: write

env:
  IMAGE: ghcr.io/${{ github.repository_owner }}/bastionvault-downloads

jobs:
  build-and-push:
    name: Build + push (linux/amd64, unsigned)
    runs-on: ubuntu-22.04
    timeout-minutes: 30

    steps:
      - name: Checkout
        uses: actions/checkout@v4
        with:
          fetch-depth: 1
          # Submodules (plugins-ext, IronRDP) are excluded by .dockerignore
          # and excluded from the cargo workspace; the downloads binary
          # depends on neither.
          submodules: false

      - name: Set up Docker Buildx
        # No QEMU step: this is an amd64-only build on an amd64 runner, and
        # the Containerfile's builder stage cross-compiles rather than
        # emulating rustc. QEMU comes back in Phase 3 with the arm64 leg.
        uses: docker/setup-buildx-action@v3

      - name: Log in to GHCR
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Extract image metadata + tags
        id: meta
        uses: docker/metadata-action@v5
        with:
          images: ${{ env.IMAGE }}
          tags: |
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=semver,pattern={{major}}
            type=raw,value=latest,enable={{is_default_branch}}
            type=raw,value=${{ inputs.tag }},enable=${{ inputs.tag != '' }}
            type=raw,value=manual-${{ github.sha }},enable=${{ github.event_name == 'workflow_dispatch' && inputs.tag == '' }}
          labels: |
            org.opencontainers.image.title=BastionVault Client Downloads
            org.opencontainers.image.description=Static download site for signed BastionVault client installers
            org.opencontainers.image.source=https://github.com/${{ github.repository }}
            org.opencontainers.image.revision=${{ github.sha }}
            org.opencontainers.image.licenses=Apache-2.0

      - name: Build + push
        id: build
        uses: docker/build-push-action@v5
        with:
          context: .
          file: deploy/downloads/Containerfile
          platforms: linux/amd64
          push: true
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            INCLUDE_SHELL=0
          # Registry cache, matching the server image's reasoning: the GitHub
          # Actions cache is capped at 10 GB per repository with LRU eviction,
          # and sharing it with the server image's mode=max export makes both
          # thrash. This graph is ~60 crates rather than ~1200, so the cache is
          # worth minutes rather than tens of them — but it costs nothing to
          # keep, and a separate tag keeps the two images out of each other's
          # way.
          cache-from: type=registry,ref=${{ env.IMAGE }}:buildcache
          cache-to:   type=registry,ref=${{ env.IMAGE }}:buildcache,mode=max

      - name: Smoke the pushed image against the checked-in fixtures
        # The same acceptance criteria features/packaging-distribution-website.md
        # states for Phase 2, run against the artefact that was just pushed
        # rather than a locally rebuilt one.
        env:
          DIGEST: ${{ steps.build.outputs.digest }}
        run: |
          IMAGE="${IMAGE}@${DIGEST}" CONTAINER_TOOL=docker PLATFORM=linux/amd64 \
              bash deploy/downloads/test/smoke.sh

      - name: Summary
        env:
          DIGEST: ${{ steps.build.outputs.digest }}
        run: |
          {
            echo "### Pushed client-downloads image"
            echo ""
            echo "Digest: \`${DIGEST}\`"
            echo ""
            echo "Tags:"
            echo '```'
            echo "${{ steps.meta.outputs.tags }}"
            echo '```'
            echo ""
            echo "Architecture: \`linux/amd64\`"
            echo ""
            echo "> **This image is NOT signed and carries no SBOM.**"
            echo "> Cosign keyless signing, the CycloneDX attestation and the"
            echo "> \`linux/arm64\` leg are Phase 3 of"
            echo "> \`features/packaging-distribution-website.md\`. Do not tell"
            echo "> operators to \`cosign verify\` it yet — there is nothing to"
            echo "> verify against."
            echo ""
            echo "Run it:"
            echo '```'
            echo "podman run -d --name bv-downloads -p 8080:8080 \\"
            echo "    -v ./client-artifacts:/srv/bv-downloads:ro,Z \\"
            echo "    ${IMAGE}@${DIGEST}"
            echo '```'
          } >> "$GITHUB_STEP_SUMMARY"
