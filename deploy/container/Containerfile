# BastionVault server — official OCI image.
#
# Wave 1: standalone, amd64.
# Wave 2: cluster mode (per-node HCL via deploy/compose/cluster.yml),
#         multi-arch (linux/amd64 + linux/arm64), Cosign keyless
#         signing, CycloneDX SBOM attestation.
#
# Cross-compilation:
#   The builder stage runs on $BUILDPLATFORM (the host arch — no QEMU on
#   the Rust toolchain, which is what kills naive multi-arch builds on
#   Apple Silicon) and Rust cross-compiles to $TARGETPLATFORM using the
#   matching gcc cross-toolchain. The runtime stage is then pulled for
#   $TARGETPLATFORM and the binary is copied in.
#
# Build context is the repository root. Build with:
#   podman build -f deploy/container/Containerfile -t bastionvault:dev .
# Or via the make target (auto-detects podman/docker, defaults to amd64):
#   make container-image
#   make container-image PLATFORM=linux/arm64
#
# Docker users need buildx for BUILDPLATFORM/TARGETPLATFORM:
#   make container-image CONTAINER_TOOL=docker BUILDX=1
# Podman supports these automatic ARGs natively.
#
# Build caching:
#   The compile is split into a dependency layer and a workspace layer with
#   cargo-chef. `chef prepare` reduces the tree to a recipe of manifests plus
#   the lock file; `chef cook` builds ~1200 third-party crates against a
#   stubbed workspace. That layer's cache key is the recipe, NOT the source
#   tree, so editing `src/` reuses it, and so does `make bump-patch` — chef
#   normalises every workspace member's version (and the lock's) to 0.0.1, so
#   a product-version bump does not touch the recipe.
#
#   The cooked artefacts live in the layer rather than in a BuildKit cache
#   mount on purpose: a mount would shadow them, and only a layer can be
#   published as an image.
#
#   That publishing is what makes CI fast. The cook lives in its own `deps`
#   stage, and `BUILDER_BASE` decides where the workspace build starts from:
#
#     unset (default)   -> `deps`, i.e. cook locally. Laptops, cold builds.
#     an image ref      -> that image IS the cooked layer; `chef`, `planner`
#                          and `deps` are then never built at all (an unused
#                          stage is skipped, even under --no-cache).
#
#   CI keys an image on the recipe's inputs (Cargo.lock, rust-toolchain.toml,
#   this file), pushes it once, and passes it back on every later run — which
#   is the only way a build gets a warm dependency layer on a runner that is a
#   fresh container every time. See bv-build's container-image workflow.
#
# See features/packaging-podman-server.md for the full design and
# roadmaps/packaging-and-distribution.md for the wave sequencing.

# Where the workspace build starts from. `deps` (the default) cooks the
# dependencies in this build; an image reference short-circuits to a previously
# cooked one. Declared before the first FROM so it is in scope for the `FROM
# ${BUILDER_BASE}` below — an ARG used in a FROM must be global.
ARG BUILDER_BASE=deps

# ---------- Stage 1: chef (toolchain base, runs on BUILDPLATFORM) ----------
# Shared by the planner and builder stages so the apt layer, the cargo-chef
# binary and the cross-env script are each built once.
FROM --platform=$BUILDPLATFORM docker.io/library/rust:1-slim-bookworm AS chef

ARG BUILDPLATFORM
ARG TARGETPLATFORM
ARG TARGETARCH

# Build tooling. The server crate is fully OpenSSL-free as of the
# FIDO2 RP migration (`src/modules/credential/fido2/rp/`), so we no
# longer need libssl-dev or the OPENSSL_STATIC dance that earlier
# revisions of this file carried.
#   - clang + cmake: covers sub-deps that need a C compiler (e.g.
#     ring, some PQ crates' build scripts).
#   - git + ca-certificates: cargo registry + submodule fetches.
#   - binutils: `readelf` for the openssl-link sanity check (needed
#     because the binary is foreign-arch when cross-compiling, so
#     `ldd` can't run on it).
#   - gcc-x86-64-linux-gnu / gcc-aarch64-linux-gnu: cross linkers and
#     C compilers for cc-rs build scripts.
# APT::Sandbox::User "root" disables apt's privilege-drop to the `_apt`
# sandbox user (uid 65534). Under rootless podman in a nested user
# namespace (e.g. a rootless-podman CI runner) the setgroups/setegid
# that drop triggers is blocked, so every download method dies with
# "setgroups (22: Invalid argument)" / HTTP 400. Running the fetch as
# root inside the already-unprivileged build container is safe and is
# the standard workaround for this environment.
RUN echo 'APT::Sandbox::User "root";' > /etc/apt/apt.conf.d/99-no-sandbox \
 && apt-get update \
 && apt-get install -y --no-install-recommends \
        binutils \
        ca-certificates \
        clang \
        cmake \
        gcc-aarch64-linux-gnu g++-aarch64-linux-gnu \
        gcc-x86-64-linux-gnu g++-x86-64-linux-gnu \
        git \
 && rm -rf /var/lib/apt/lists/*

# cargo-chef itself. Pinned to a minor range: `cook` has to keep accepting
# the same flags the builder stage passes, and the recipe format is internal
# to the tool. Its own layer, so it is built once and never again.
RUN cargo install cargo-chef --locked --version '^0.1'

# Target triple, cross toolchain and job count, resolved in one place and
# sourced by every cargo step below. See the script's header for why this is
# not inlined twice.
COPY --chmod=0755 deploy/container/cross-env.sh /usr/local/bin/bv-cross-env

WORKDIR /src

# The pinned toolchain, materialised once for every stage that inherits `chef`.
#
# rust-toolchain.toml pins `stable`, which is NOT the channel the base image
# defaults to, so the first cargo/rustup call under a directory carrying this
# file makes rustup sync the whole channel. That used to happen twice per build
# — once in `planner` (2m33s inside what is supposed to be a manifest read) and
# again in the builder — and the planner copy could never be cached, because
# that stage is invalidated by every source edit. Installing it here puts it in
# a layer keyed on this one file, which every stage below inherits and no source
# change touches.
#
# `rustup show` is the install: under a directory override it resolves the
# override and downloads it if missing.
COPY rust-toolchain.toml ./
RUN rustup show

# ---------- Stage 2: planner (recipe only — no compilation) ----------
# The one stage that sees the whole source tree. It is invalidated by every
# edit, which is fine: it only reads manifests and writes a ~450 KB recipe.
FROM chef AS planner
COPY . .
RUN cargo chef prepare --recipe-path /recipe.json

# ---------- Stage 3: deps (the dependency compile — the cacheable half) ----
# Everything here is a function of the recipe and the toolchain, never of the
# application source. CI publishes this stage as an image and feeds it back as
# BUILDER_BASE, so the ~1200-crate cook happens once per Cargo.lock rather than
# once per run.
FROM chef AS deps

ARG TARGETARCH

# Both HSM auto-unseal backends are baked into the official image so a single
# artifact serves production and homologation:
#   - hsm_yubihsm2: real YubiHSM 2 (production). libusb is compiled statically
#     from vendored C source (rusb `vendored` feature), so no libusb dev is
#     needed here and no libusb .so is needed in the runtime stage.
#   - hsm_mock: software mock for dev/homolog. It REFUSES to start when the
#     environment is production, so shipping it here is safe — the active
#     backend is chosen at runtime by the `hsm "<label>"` config block.
# See features/hsm-support.md.
ARG BVAULT_FEATURES="hsm_mock,hsm_yubihsm2"
# Empty = one job per core. See cross-env.sh; the old hard-coded 2 was a
# no-cache-era hedge and cost more than anything else in this file.
ARG CARGO_BUILD_JOBS=""

# The cross-compilation std for the target triple. `rustup target add` honours
# the directory override, so it lands on the `stable` channel that `chef`
# installed from rust-toolchain.toml — not the base image's default. Without
# that pairing the target lands on the wrong toolchain and the cook step fails
# with `can't find crate for core` the moment chef hydrates its own copy of the
# toolchain file.
RUN . /usr/local/bin/bv-cross-env && rustup target add "$RUST_TARGET"

# The dependency layer. Keyed on the recipe alone.
#
# The two `cook` invocations mirror the two `cargo build` invocations below
# line for line — same package selection, same features, same target. They
# have to: cargo fingerprints the feature set, so a cook that does not match
# its build produces artefacts the build ignores. Change one, change both.
COPY --from=planner /recipe.json /recipe.json
RUN set -eux; \
    . /usr/local/bin/bv-cross-env; \
    cargo chef cook --release --recipe-path /recipe.json --target "$RUST_TARGET" \
        -p bvault-cli ${BVAULT_FEATURES:+--features "$BVAULT_FEATURES"}; \
    cargo chef cook --release --recipe-path /recipe.json --target "$RUST_TARGET" \
        -p bastion_vault

# ---------- Stage 4: builder (the workspace) ----------
# `deps` by default; a published image when CI passes one. Either way the
# contract is identical: /src carries the cooked target/ and registry, the
# pinned toolchain is installed, and bv-cross-env is on PATH.
#
# The ARGs are re-declared because a stage does not inherit the ones above it,
# and the two `cargo build` invocations below must see exactly the features and
# job count the `cook` above them saw — cargo fingerprints the feature set, so a
# mismatch silently discards every cooked artefact and rebuilds the lot.
#
# `--platform=$BUILDPLATFORM` is not decoration. It used to come for free from
# `FROM chef`; naming a base explicitly would otherwise default this stage to
# TARGETPLATFORM and put rustc under QEMU — the exact thing this file's header
# says kills a cross-arch build. It also means a *published* BUILDER_BASE is
# specific to the build host's architecture, not just the target's.
FROM --platform=$BUILDPLATFORM ${BUILDER_BASE} AS builder

ARG TARGETARCH
ARG BVAULT_FEATURES="hsm_mock,hsm_yubihsm2"
ARG CARGO_BUILD_JOBS=""

WORKDIR /src

# Output goes to /out/ so the runtime stage doesn't need the target triple.
COPY . .
RUN set -eux; \
    . /usr/local/bin/bv-cross-env; \
    cargo build --release --target "$RUST_TARGET" -p bvault-cli ${BVAULT_FEATURES:+--features "$BVAULT_FEATURES"} --bin bvault; \
    cargo build --release --target "$RUST_TARGET" -p bastion_vault --bin bv-ssh-helper; \
    mkdir -p /out; \
    cp "target/${RUST_TARGET}/release/bvault"        /out/bvault; \
    cp "target/${RUST_TARGET}/release/bv-ssh-helper" /out/bv-ssh-helper

# Belt-and-braces: confirm the resulting binary really doesn't need
# libssl at runtime. Distroless has no libssl, so a stray dynamic link
# would fail at container start with a confusing "cannot find
# libssl.so.3" error. Failing the build here surfaces the regression at
# build time, before publish. We use `readelf -d` (static, arch-agnostic)
# instead of `ldd` because the binary may be foreign-arch.
RUN if readelf -d /out/bvault | grep -E 'NEEDED.*(libssl|libcrypto)'; then \
        echo "ERROR: bvault is dynamically linked against openssl. The server crate is supposed to be openssl-free; some new dep has reintroduced it."; \
        exit 1; \
    fi

# ---------- Stage 5: runtime (pulled for TARGETPLATFORM) ----------
# Wolfi — Chainguard's free, open-source, glibc-based "undistro" built
# for containers (cgr.dev/chainguard/wolfi-base). Like distroless it
# carries glibc + a CA bundle and nothing application-specific, so the
# CVE surface stays minimal; unlike distroless it ships `apk` and a
# POSIX shell (busybox) in the base, so we install the CA bundle inline
# (and reuse the base's pre-existing nonroot user) instead of staging
# them from a separate Debian layer. The bvault binary is dynamically
# linked against glibc and
# Wolfi's glibc is forward-compatible with the older glibc the Debian
# builder stage links against, so the cross-built binary runs as-is.
#
# `INCLUDE_SHELL` (default 1) keeps Wolfi's bundled busybox shell so
# `podman exec` / `kubectl exec` and the in-container
# `rustion-master-bootstrap.sh` work out of the box. INCLUDE_SHELL=0
# strips busybox + apk, restoring the classic shell-less,
# package-manager-less hardened posture (smallest attack surface,
# nothing to drop into on `exec`). The :debug variant layers on
# ss / ip / tcpdump / curl for incident response.
FROM --platform=$TARGETPLATFORM cgr.dev/chainguard/wolfi-base:latest AS runtime

ARG INCLUDE_SHELL=1

LABEL org.opencontainers.image.title="BastionVault" \
      org.opencontainers.image.description="Identity-based secrets management server (Vault-API compatible)" \
      org.opencontainers.image.source="https://github.com/ffquintella/BastionVault" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="BastionVault" \
      org.opencontainers.image.base.name="cgr.dev/chainguard/wolfi-base:latest"

# CA bundle for outbound TLS. Wolfi-base already ships the `nonroot`
# user/group at UID/GID 65532 (created by apko) — the same UID this
# image has always run as and the distroless `nonroot` convention — so
# we reuse it rather than re-create a duplicate /etc/passwd entry. When
# INCLUDE_SHELL=0 we drop busybox + apk so nothing remains to `exec`
# into.
RUN set -eux; \
    apk add --no-cache ca-certificates-bundle; \
    if [ "${INCLUDE_SHELL}" = "0" ]; then \
        rm -rf /bin/busybox /bin/sh /usr/bin/busybox \
               /sbin/apk /usr/bin/apk /lib/apk /etc/apk /var/cache/apk; \
    fi

# Binaries.
COPY --from=builder /out/bvault         /usr/local/bin/bvault
COPY --from=builder /out/bv-ssh-helper  /usr/local/bin/bv-ssh-helper

# Operator bootstrap script for the Rustion master keypair. POSIX sh so
# it runs under Wolfi's bundled busybox shell (INCLUDE_SHELL=1, the
# default). Operators who opt out of the shell with
# `--build-arg INCLUDE_SHELL=0` should `podman cp` this file out and run
# it from the host instead.
COPY --chmod=0755 scripts/rustion-master-bootstrap.sh /usr/local/bin/rustion-master-bootstrap.sh

# Inert sample config (file storage at /var/lib/bvault/data, TLS expected
# at /etc/bvault/tls/). The operator MUST mount their own config and
# TLS material; the server refuses to start with the bundled sample
# unmodified because the storage backend secrets are placeholder values.
COPY deploy/container/config/config.hcl.sample /etc/bvault/config.hcl

# Mount points, pre-created and owned by the runtime UID so a fresh named
# volume inherits that ownership (a VOLUME path that does not exist in the
# image is created root-owned by the engine, which UID 65532 then cannot
# write).
#   - data/    — storage backend (Hiqlite SQLite + Raft logs).
#   - backups/ — default destination for scheduled backups. The scheduler
#     writes `.bvx`/`.json` files straight to the server's filesystem, so a
#     destination that is not a mounted volume lives in the container's
#     ephemeral writable layer and every file is discarded when the container
#     is recreated — the schedule survives (it is in the barrier store on the
#     data volume) but its backup files do not.
RUN mkdir -p /var/lib/bvault/data /var/lib/bvault/backups \
 && chown -R 65532:65532 /var/lib/bvault

# nonroot UID shipped by the Wolfi base.
USER 65532:65532

# Storage + backup volumes. The image expects the operator to mount real
# persistent storage here; without it the container is a sealed-only
# scratchpad whose data dies with the container.
VOLUME ["/var/lib/bvault/data", "/var/lib/bvault/backups"]

# Working directory anchored to the data volume so any relative paths
# in operator-supplied configs resolve sensibly.
WORKDIR /var/lib/bvault

# API listener.
EXPOSE 8200

ENTRYPOINT ["/usr/local/bin/bvault"]
CMD ["server", "--config", "/etc/bvault/config.hcl"]
